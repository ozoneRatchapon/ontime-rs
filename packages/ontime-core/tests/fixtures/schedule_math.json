    { "name": "absolute: behind with too little gap", "event": { "timeStart": 100, "dayOffset": 0, "delay": 0 }, "state": { "currentDay": 0, "totalGap": 10, "isLinkedToLoaded": false, "offset": 20, "mode": "absolute", "actualStart": 0, "plannedStart": 0 }, "expected": 110 },
