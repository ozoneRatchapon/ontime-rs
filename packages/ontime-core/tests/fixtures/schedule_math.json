    { "name": "edge: running late pushes 23:50 past midnight", "event": { "timeStart": 85800000, "dayOffset": 0, "delay": 0 }, "state": { "currentDay": 0, "totalGap": 0, "isLinkedToLoaded": false, "offset": 1200000, "mode": "absolute", "actualStart": null, "plannedStart": null }, "expected": 87000000 },
    { "name": "edge: next-day event keeps its slot when the overnight gap absorbs lateness", "event": { "timeStart": 0, "dayOffset": 1, "delay": 0 }, "state": { "currentDay": 0, "totalGap": 86399980, "isLinkedToLoaded": false, "offset": 100, "mode": "absolute", "actualStart": null, "plannedStart": null }, "expected": 86400000 },
    { "name": "edge: relative mode with nulls treats them as zero", "event": { "timeStart": 100, "dayOffset": 0, "delay": 0 }, "state": { "currentDay": 0, "totalGap": 0, "isLinkedToLoaded": true, "offset": 0, "mode": "relative", "actualStart": null, "plannedStart": null }, "expected": 100 }
  ],
  "expected_end": [
    { "name": "a normal event ends at its expected start plus its duration", "event": { "timeStart": 1000, "dayOffset": 0, "duration": 500, "countToEnd": false }, "expectedStart": 2000, "currentDay": 0, "expected": 2500 },
    { "name": "count to end: ends at the planned end", "event": { "timeStart": 1000, "dayOffset": 0, "duration": 500, "countToEnd": true }, "expectedStart": 1200, "currentDay": 0, "expected": 1500 },
